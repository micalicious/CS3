class BankAccount:
    def __init__(self, name, number, balance):
        self.__name = name
        self.__number = number
        self.__balance = balance

    def display(self):
        print(self.__name, self.__number, self.__balance)


class SavingsAccount(BankAccount):
    def __init__(self, name, number, balance):
        super().__init__(name, number, balance)

    def display(self):
        print("Savings Account:")
        super().display()


class Bank:
    def __init__(self):
        self.accounts = []

    def add(self, account):
        self.accounts.append(account)

    def search(self, number):
        for account in self.accounts:
            if account._BankAccount__number == number:
                return account
        return None

    def show(self):
        for account in self.accounts:
            account.display()
            print("Savings:", isinstance(account, SavingsAccount))


bank = Bank()

bank.add(BankAccount("Denise", "1001", 5000))
bank.add(SavingsAccount("Maria", "1002", 10000))

number = input("Enter account number: ")
account = bank.search(number)

if account:
    account.display()
    print("Savings:", isinstance(account, SavingsAccount))
else:
    print("Account not found.")